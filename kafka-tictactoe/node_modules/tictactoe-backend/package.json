{
  "name": "tictactoe-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "build:prod": "tsc --sourceMap false",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "start:prod:win": "set NODE_ENV=production && node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "deploymentConfig": {
    "production": {
      "port": 3001,
      "env": "NODE_ENV=production",
      "instructions": "1. Run 'npm run build:prod' 2. Deploy dist/ folder to production server 3. Use PM2 or systemd to manage the process"
    },
    "nginx": {
      "reverseProxy": true,
      "upstreamName": "backend",
      "upstreamUrl": "http://127.0.0.1:3001",
      "configFile": "nginx.conf.example",
      "websocketHeaders": "proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection 'upgrade'; proxy_set_header Host $host; proxy_cache_bypass $http_upgrade;"
    },
    "apache": {
      "reverseProxy": true,
      "modules": ["mod_proxy", "mod_proxy_http", "mod_proxy_wstunnel"],
      "configFile": "apache.conf.example",
      "enableModules": "sudo a2enmod proxy proxy_http proxy_wstunnel rewrite"
    }
  }
}
